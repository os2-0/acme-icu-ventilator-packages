<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="Initialization" name="pressure-sensor">
    <state id="Initialization">
    <transition event="ready" target="Available"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Available">
    <transition event="lose" target="Unavailable"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Unavailable">
    <transition event="recover" target="Available"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Fault">
    <transition event="reset" target="Initialization"/>
  </state>
</scxml>
