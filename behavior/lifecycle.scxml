<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="Initialization" name="watchdog-module">
    <state id="Initialization">
    <transition event="ready" target="Ready"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Ready">
    <transition event="enable" target="Active"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Active">
    <transition event="disable" target="Ready"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Fault">
    <transition event="reset" target="Initialization"/>
  </state>
</scxml>
