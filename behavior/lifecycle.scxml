<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="Stopped" name="control-system">
    <state id="Stopped">
    <transition event="boot" target="Initializing"/>
  </state>
  <state id="Initializing">
    <transition event="ready" target="Ready"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Ready">
    <transition event="halt" target="Stopped"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Fault">
    <transition event="reset" target="Stopped"/>
  </state>
</scxml>
