<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="Uninstalled" name="impeller">
    <state id="Uninstalled">
    <transition event="install" target="Installed"/>
  </state>
  <state id="Installed">
    <transition event="retire" target="Retired"/>
  </state>
  <state id="Retired">
  </state>
</scxml>
