<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="Initialization" name="buzzer">
    <state id="Initialization">
    <transition event="ready" target="Ready"/>
    <transition event="fail" target="Error"/>
  </state>
  <state id="Ready">
    <transition event="hide" target="Unavailable"/>
    <transition event="fail" target="Error"/>
  </state>
  <state id="Unavailable">
    <transition event="show" target="Ready"/>
    <transition event="fail" target="Error"/>
  </state>
  <state id="Error">
    <transition event="reset" target="Initialization"/>
  </state>
</scxml>
