<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="Isolated" name="power-system">
  <!-- Engineering lifecycle model for @acme/power-system. Synthetic educational OS20 fixture. Not a medical device, not a validated ventilator, and not regulatory, clinical, or safety evidence. -->
  <state id="Isolated">
    <transition event="source-present" target="SourceAvailable"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="SourceAvailable">
    <transition event="lose-source" target="Isolated"/>
    <transition event="fault" target="Fault"/>
  </state>
  <state id="Fault">
    <transition event="reset" target="Isolated"/>
  </state>
</scxml>
